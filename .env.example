# ---------------------------------------------------------------
# bipinkr.in — public runtime configuration
#
# Every value here is compiled into the static bundle and is
# therefore PUBLIC. Never put API secrets, tokens or private keys
# in this file.
#
# Copy to `.env.local` and fill in. All values are optional:
# the site degrades gracefully when one is missing (it hides the
# feature rather than rendering a broken link).
# ---------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://bipinkr.in

# Contact form POST endpoint (e.g. Formspree, Web3Forms, Basin, Getform).
# If empty, the contact form renders a setup notice instead of pretending to send.
NEXT_PUBLIC_FORM_ENDPOINT=

# WhatsApp number in international format, digits only, no + or spaces.
# Example for India: 919876543210
# If empty, every WhatsApp button is hidden rather than rendered broken.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email. If empty, the email contact card is hidden.
NEXT_PUBLIC_CONTACT_EMAIL=

# Full LinkedIn profile URL. If empty, every LinkedIn button is hidden.
# Set in .env.production. Surfaces in the footer Connect column, the About
# page intro, the recruiter CTA and the contact page alternatives.
NEXT_PUBLIC_LINKEDIN_URL=

# Resume file placed in /public/documents/. If the file is absent the
# resume page shows a placeholder state instead of a broken embed.
NEXT_PUBLIC_RESUME_FILE=bipin-kumar-resume.pdf

# ---------------------------------------------------------------
# TRACKING & CONVERSION MEASUREMENT
#
# All four IDs are optional. Leave one blank and that platform is not
# loaded at all — no script tag, no third-party request, no cookie.
# The site builds and converts identically with every value empty.
#
# Each value is format-validated before it is used in a script URL.
# A malformed ID is treated as absent rather than injected.
#
# These IDs are PUBLIC by definition (they ship in the HTML). They are
# not secrets — but they are also not placeholders: leave them blank
# until you have created the real containers and properties.
# ---------------------------------------------------------------

# NOTE ON WHERE THESE LIVE
#
# Public production values are committed in `.env.production`, which
# `next build` loads automatically. That is deliberate: keeping them only
# in an untracked `.env.local` meant a build on a different machine
# silently shipped a site with no tag manager on it.
#
# Use `.env.local` (untracked) only to OVERRIDE production values while
# testing locally. Never put a secret in either file — every value here is
# compiled into the HTML.

# Google Tag Manager container. THE PRIMARY TAG-MANAGEMENT LAYER.
# Configure GA4, Google Ads and Meta Pixel as tags inside this container
# rather than loading them directly. Format: GTM-XXXXXXX
# Currently set in .env.production.
NEXT_PUBLIC_GTM_ID=

# GA4 measurement ID. Format: G-XXXXXXXXXX
#
# LEAVE THIS EMPTY while GTM is in use. GA4 is served by the Google tag
# inside the GTM container. Setting it here loads gtag.js from the page as
# well, creating a second GA4 instance and duplicate page_view hits.
# It exists only as a fallback for a deployment with no GTM container.
NEXT_PUBLIC_GA4_ID=

# Google Ads conversion ID. Format: AW-123456789
# The conversion ACTION LABEL is configured in GTM, not here — see
# docs/tracking-architecture.md.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta Pixel ID. Numeric, 10-20 digits.
NEXT_PUBLIC_META_PIXEL_ID=

# Consent handling. "off" (default) or "required".
#   off      - no consent gating; tags load normally
#   required - Google Consent Mode v2 defaults set to DENIED before GTM
#              loads; tags stay held until a real consent platform calls
#              window.__bkTrackingConsent('granted')
# This site ships no consent banner. Set "required" only once a real
# consent management platform is in place.
NEXT_PUBLIC_CONSENT_MODE=off

# Mirrors every dataLayer push to the browser console. Development only —
# it is ignored in production builds.
NEXT_PUBLIC_TRACKING_DEBUG=
