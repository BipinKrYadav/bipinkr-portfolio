# ---------------------------------------------------------------
# Production environment — loaded automatically by `next build`.
#
# This file IS committed, deliberately. Everything in it is public by
# definition: these values are compiled into the static HTML and are
# readable by anyone who views source. None of them is a secret.
#
# It exists because the previous setup kept configuration only in an
# untracked `.env.local`, which meant a build on any other machine
# silently produced a site with no tag manager on it. Committing the
# public IDs makes every production build reproducible.
#
# NEVER put a secret here: no API keys, no access tokens, no Meta
# Conversions API token. Those belong in a server-side secret store,
# and this project has no server.
# ---------------------------------------------------------------

# Google Tag Manager container — the single tag-management layer.
# GA4, Google Ads and Meta Pixel are configured as tags INSIDE this
# container, never loaded directly by the site.
NEXT_PUBLIC_GTM_ID=GTM-NTDV5NHD

# Deliberately empty — do not fill these in.
#
# GA4 is served by the "Google tag – GA4 – Bipin Kumar Portfolio" tag
# (G-XDGM90H8WH) inside the GTM container above. Setting NEXT_PUBLIC_GA4_ID
# here would ALSO load gtag.js directly from the page, producing a second
# GA4 instance and duplicate page_view hits.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Consent gating. "off" until a real consent platform is connected.
NEXT_PUBLIC_CONSENT_MODE=off

# ---------------------------------------------------------------
# CONTACT & SOCIAL
#
# Each value is optional. An empty one hides its UI entirely rather
# than rendering a broken link or a placeholder.
# ---------------------------------------------------------------

# Public LinkedIn profile. Shown in the footer Connect column, the
# About page intro, the recruiter CTA (about / contact / resume) and
# the contact page alternatives. Every link opens in a new tab with
# rel="noopener noreferrer".
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/bipin-kumar-321957281/

# WhatsApp, international format, digits only — no "+", no leading zero.
# 91 = India country code. Produces https://wa.me/919631595116?text=...
# Empty would hide every WhatsApp CTA rather than render a broken link.
NEXT_PUBLIC_WHATSAPP_NUMBER=919631595116

# Contact form POST target (Formspree).
#
# The form posts FormData with `Accept: application/json`; Formspree replies
# 2xx JSON on success and 4xx on rejection, which is exactly what
# ContactForm's `response.ok` check expects. A non-2xx shows the error state
# and fires NO conversion.
#
# This is a public endpoint ID, not a secret — it ships in the HTML. Keep
# Formspree's own spam filtering on; the form's `_gotcha` honeypot is the
# first line only.
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mjyvagwy

# Still to be configured — optional.
NEXT_PUBLIC_CONTACT_EMAIL=
