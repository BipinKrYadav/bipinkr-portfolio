# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# admin panel (separate static app in admin/)
/admin/.next/
/admin/out/

# misc
.DS_Store
*.pem
Thumbs.db

# local tooling
#
# Claude Code's per-machine configuration (dev-server launch config and
# similar). Useful locally, but it describes one developer's environment
# rather than the project, so it stays out of version control.
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
#
# `.env.production` is intentionally NOT ignored. It holds only public,
# non-secret values (the GTM container ID) that are compiled into the HTML
# anyway, and committing it is what makes a production build reproducible
# on any machine. Never add a secret to it.
.env
.env*.local

# typescript
*.tsbuildinfo

# supabase cli local state (project refs, local branches, generated secrets)
/supabase/.temp/
/supabase/.branches/
/supabase/.env
/supabase/seed.sql

# ---------------------------------------------------------------
# Raw evidence: campaign exports must NEVER be committed publicly.
# They contain account IDs, campaign IDs and lead-level data.
# ---------------------------------------------------------------
/private/
/raw-data/
*.xlsx
*.xls
*.csv
