# Admin panel settings. Copy to admin/.env.local (git-ignored) and fill in.
#
# These two values are compiled into the browser bundle, which is safe and
# intended: data stays protected by RLS, which requires an allow-listed admin
# with an MFA-verified session.
#
# Never put any other Supabase value here. The service-role/secret key, the
# database password and the JWT secret must never be NEXT_PUBLIC_*: the build
# fails if one is (admin/config/public-env-guard.mjs).
#
# A build for deployment (CI, or ADMIN_BUILD_TARGET=deploy) fails when these
# are missing, so the "Authentication not configured" shell cannot be shipped.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
