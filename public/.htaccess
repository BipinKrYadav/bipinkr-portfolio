# =====================================================================
# bipinkr.in — Apache configuration for Hostinger shared hosting
#
# This file is copied verbatim into the export by `next build`, so it
# ends up at the web root alongside index.html. Upload the whole
# contents of /out to public_html and this comes with it.
#
# If you cannot see it after uploading, enable "show hidden files" in
# the Hostinger File Manager — names beginning with a dot are hidden
# by default.
# =====================================================================

# ---------------------------------------------------------------------
# Custom 404
# Next.js exports the not-found page as /404.html.
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------
# Correct MIME types
#
# The Open Graph card is generated by Next.js as an extensionless file
# named `opengraph-image`. Without this rule Apache serves it as
# application/octet-stream and social scrapers reject the preview.
# ---------------------------------------------------------------------
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_mime.c>
  AddType image/svg+xml            .svg
  AddType application/pdf          .pdf
  AddType font/woff2               .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------
# Clean URLs
#
# The site is built with trailingSlash: true, so every route already
# exports as <route>/index.html and Apache resolves it via DirectoryIndex.
# This block only redirects the legacy no-slash form to the canonical
# trailing-slash URL, so there is exactly one address per page.
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite a request that maps to a real file or directory.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /about  ->  /about/   (only when the directory actually exists)
  RewriteCond %{REQUEST_FILENAME}/ -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# ---------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# Caching
#
# Everything under /_next/static is content-hashed and safe to cache
# forever. HTML must revalidate so a redeploy is picked up immediately.
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType application/pdf           "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Baseline security headers. No CSP is set here: it needs to be tuned
  # against whichever form endpoint and analytics provider you configure.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---------------------------------------------------------------------
# Force HTTPS
# Uncomment once the SSL certificate is active in hPanel.
# ---------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
